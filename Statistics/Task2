#Sual 2: 2 zər atılır. Expected value və variance-ı hesabla
import numpy as np

n = 100000
sums = []

for _ in range(n):
    z1 = np.random.randint(1,7)
    z2 = np.random.randint(1,7)
    sums.append(z1 + z2)
E=sum(sums)/n
###E = np.mean(sums)
summm=np.array(sums)

var=np.average(summm**2)-np.average(summm)**2
##Var = np.var(sums)

print("Expected value:", E)
print("Variance:", var)
